# Copy to .env and fill in the values.

# Proton WireGuard private key (Proton account -> Downloads -> WireGuard
# configuration -> "PrivateKey = ..."). One key works for every free-tier
# server of the same region group.
WIREGUARD_PRIVATE_KEY=

# Pinned exit server. rotate_on_429.py rewrites this to walk to the next
# free-tier host in servers.txt and get a fresh exit IP.
#
# NOTE: hostname only. Do NOT add SERVER_COUNTRIES next to it - gluetun
# AND-s the two filters, so a country here plus a foreign hostname matches
# no server at all and the tunnel never comes up.
SERVER_HOSTNAMES=node-jp-39.protonvpn.net
