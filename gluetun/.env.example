# Copy to .env and fill in the values.

# Proton WireGuard private key (Proton account -> Downloads -> WireGuard
# configuration -> "PrivateKey = ..."). One key works for every free-tier
# server of the same region group.
WIREGUARD_PRIVATE_KEY=

# Exit country. rotate_on_429.py rewrites this to switch to another
# free-tier country and get a fresh exit IP.
SERVER_COUNTRIES=Netherlands
