# Provider API keys for OpenCode. Copy to ~/.config/opencode/opencode.env
# (chmod 600) and fill in. Never commit the real file.
#
# Kilo Code gateway: https://api.kilo.ai/api/gateway
# opencode's built-in "kilo" provider picks this up automatically and uses
# it as the Bearer token. Free models available, e.g.
#   kilo/minimax/minimax-m3.1-flash:free   (1M context)
#   kilo/nvidia/nemotron-3.5-super-vl:free
KILO_API_KEY=
